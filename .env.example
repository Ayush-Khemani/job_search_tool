# Copy to .env and fill in only the services you use.
# .env itself is gitignored and must never be committed.

# Optional: required only for AI fit evaluation.
# ChatGPT subscriptions and API billing are separate; obtain an API key from
# the OpenAI API platform and add API billing/credits there.
OPENAI_API_KEY=sk-...

# Cost-sensitive default for high-volume job scoring. Override freely.
OPENAI_MODEL=gpt-5.6-luna

# Required only for Adzuna entries in aggregators.yaml.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
